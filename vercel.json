{
  "framework": "vite",
  "redirects": [
    {
      "source": "/Ladidier Portal-print.html",
      "destination": "/print.html",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/auth/:action", "destination": "/api/auth-router" },
    { "source": "/api/account/:action", "destination": "/api/account-router" },
    { "source": "/api/issue/:action", "destination": "/api/issue-router" },
    { "source": "/read", "destination": "/index.html" },
    { "source": "/reader", "destination": "/index.html" }
  ],
  "functions": {
    "api/issue-router.js": {
      "includeFiles": "content/**"
    }
  }
}
